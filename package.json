{
  "name": "village-connect",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["server", "client", "database"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=database && npm run build --workspace=server && npm run build --workspace=client",
    "db:push": "npm run db:push --workspace=database",
    "db:migrate": "npm run db:migrate --workspace=database",
    "db:seed": "npm run db:seed --workspace=database",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
